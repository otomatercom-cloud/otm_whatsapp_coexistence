<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_privilege" model="res.groups.privilege">
        <field name="name">WhatsApp</field>
        <field name="category_id" ref="base.module_category_customizations"/>
    </record>

    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">WhatsApp / User</field>
        <field name="privilege_id" ref="whatsapp_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view assigned WhatsApp numbers/conversations and send messages.</field>
    </record>

    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">WhatsApp / Manager</field>
        <field name="privilege_id" ref="whatsapp_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="comment">Can manage assigned numbers, assign conversations, manage templates.</field>
    </record>

    <record id="group_whatsapp_administrator" model="res.groups">
        <field name="name">WhatsApp / Administrator</field>
        <field name="privilege_id" ref="whatsapp_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_manager'))]"/>
        <field name="comment">Can configure the Meta integration, add/sync numbers, manage users/teams and webhooks.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
