<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_phone_form" model="ir.ui.view">
        <field name="name">otm.whatsapp.phone.form</field>
        <field name="model">otm.whatsapp.phone</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Number">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="status == 'connected'"/>
                    <button name="action_deactivate" type="object" string="Deactivate" class="btn-secondary" invisible="status != 'connected'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_whatsapp_conversation)d" type="action" class="oe_stat_button" icon="fa-comments"
                                context="{'search_default_phone_id': id}">
                            <field name="conversation_count" widget="statinfo" string="Conversations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h3><field name="display_phone_number" placeholder="+91 90000 11111"/></h3>
                    </div>
                    <group>
                        <group string="Meta Identifiers">
                            <field name="integration_id"/>
                            <field name="phone_number_id"/>
                            <field name="verified_name"/>
                            <field name="quality_rating"/>
                        </group>
                        <group string="Coexistence">
                            <field name="coexistence_status"/>
                            <field name="is_default"/>
                            <field name="connected_date"/>
                            <field name="last_sync"/>
                            <field name="last_webhook"/>
                        </group>
                    </group>
                    <group string="Assignment">
                        <field name="team_id"/>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_phone_list" model="ir.ui.view">
        <field name="name">otm.whatsapp.phone.list</field>
        <field name="model">otm.whatsapp.phone</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Numbers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="display_phone_number"/>
                <field name="status" decoration-success="status == 'connected'" decoration-danger="status == 'error'"/>
                <field name="coexistence_status"/>
                <field name="team_id"/>
                <field name="unread_count"/>
                <field name="last_webhook"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_phone_search" model="ir.ui.view">
        <field name="name">otm.whatsapp.phone.search</field>
        <field name="model">otm.whatsapp.phone</field>
        <field name="arch" type="xml">
            <search string="WhatsApp Numbers">
                <field name="name"/>
                <field name="display_phone_number"/>
                <field name="integration_id"/>
                <filter name="connected" string="Connected" domain="[('status', '=', 'connected')]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_by_integration" string="Integration" context="{'group_by': 'integration_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_phone" model="ir.actions.act_window">
        <field name="name">WhatsApp Numbers</field>
        <field name="res_model">otm.whatsapp.phone</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
