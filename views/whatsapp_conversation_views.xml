<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_conversation_form" model="ir.ui.view">
        <field name="name">otm.whatsapp.conversation.form</field>
        <field name="model">otm.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Conversation">
                <header>
                    <button name="action_close" type="object" string="Close" class="btn-secondary" invisible="status == 'closed'"/>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-primary" invisible="status != 'closed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="open,pending,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone_id"/>
                            <field name="contact_id"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="assigned_team_id"/>
                            <field name="unread_count"/>
                            <field name="last_message_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids" nolabel="1">
                                <list decoration-muted="direction == 'in'" default_order="create_date">
                                    <field name="create_date"/>
                                    <field name="direction"/>
                                    <field name="message_type"/>
                                    <field name="body"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_conversation_list" model="ir.ui.view">
        <field name="name">otm.whatsapp.conversation.list</field>
        <field name="model">otm.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Conversations">
                <field name="name"/>
                <field name="phone_id"/>
                <field name="assigned_user_id"/>
                <field name="status"/>
                <field name="unread_count"/>
                <field name="last_message"/>
                <field name="last_message_date"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_conversation_search" model="ir.ui.view">
        <field name="name">otm.whatsapp.conversation.search</field>
        <field name="model">otm.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <search string="WhatsApp Conversations">
                <field name="name"/>
                <field name="phone_id"/>
                <field name="assigned_user_id"/>
                <filter name="unread" string="Unread" domain="[('unread_count', '&gt;', 0)]"/>
                <filter name="open" string="Open" domain="[('status', '=', 'open')]"/>
                <filter name="mine" string="Assigned to Me" domain="[('assigned_user_id', '=', uid)]"/>
                <separator/>
                <group>
                    <filter name="group_by_phone" string="Number" context="{'group_by': 'phone_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">otm.whatsapp.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_whatsapp_conversation_search"/>
    </record>
</odoo>
