<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_integration_form" model="ir.ui.view">
        <field name="name">otm.whatsapp.integration.form</field>
        <field name="model">otm.whatsapp.integration</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Meta Integration">
                <header>
                    <button name="action_check_connection" type="object" string="Check Connection" class="btn-secondary"/>
                    <button name="action_sync_numbers" type="object" string="Sync WhatsApp Numbers" class="btn-primary"/>
                    <field name="connection_state" widget="statusbar" statusbar_visible="not_connected,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_whatsapp_phone)d" type="action" class="oe_stat_button" icon="fa-phone"
                                context="{'search_default_integration_id': id}">
                            <field name="phone_count" widget="statinfo" string="Numbers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Otomater Main WABA"/></h1>
                    </div>
                    <group>
                        <group string="Meta Business Configuration">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="business_account_id"/>
                            <field name="business_id"/>
                            <field name="app_id"/>
                            <field name="graph_api_version"/>
                        </group>
                        <group string="Status">
                            <field name="active"/>
                            <field name="last_check"/>
                            <field name="last_error" invisible="not last_error"/>
                        </group>
                    </group>
                    <group string="Credentials (Administrator only)">
                        <field name="access_token" password="True"/>
                        <field name="webhook_verify_token" password="True"/>
                        <field name="app_secret" password="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_integration_list" model="ir.ui.view">
        <field name="name">otm.whatsapp.integration.list</field>
        <field name="model">otm.whatsapp.integration</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Integrations">
                <field name="name"/>
                <field name="business_account_id"/>
                <field name="phone_count"/>
                <field name="connection_state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_whatsapp_integration" model="ir.actions.act_window">
        <field name="name">WhatsApp Integration</field>
        <field name="res_model">otm.whatsapp.integration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
