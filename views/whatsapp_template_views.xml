<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">otm.whatsapp.template.form</field>
        <field name="model">otm.whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <sheet>
                    <div class="oe_title">
                        <label for="template_name"/>
                        <h1><field name="template_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="integration_id"/>
                            <field name="language"/>
                            <field name="category"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="meta_template_id"/>
                            <field name="variable_count"/>
                            <field name="has_buttons"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Components (raw Meta structure)">
                        <field name="components_json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_template_list" model="ir.ui.view">
        <field name="name">otm.whatsapp.template.list</field>
        <field name="model">otm.whatsapp.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates">
                <field name="template_name"/>
                <field name="language"/>
                <field name="category"/>
                <field name="status" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'"/>
                <field name="integration_id"/>
            </list>
        </field>
    </record>

    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">otm.whatsapp.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
